POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ppe_compliance
POSTGRES_USER=ppe_user
POSTGRES_PASSWORD=replace-with-a-strong-password

PPE_NVR_192_169_0_65_USERNAME=
PPE_NVR_192_169_0_65_PASSWORD=
PPE_NVR_192_168_100_65_USERNAME=
PPE_NVR_192_168_100_65_PASSWORD=

PPE_MODEL_PATH=models\best.pt
PPE_FEEDBACK_DATASET_DIR=dataset\feedback
PPE_EVIDENCE_CLIP_DIR=evidence\clips
PPE_EVIDENCE_CLIP_PRE_SECONDS=5
PPE_EVIDENCE_CLIP_POST_SECONDS=5
PPE_EVIDENCE_CLIP_FPS=4
PPE_EVIDENCE_CLIP_WIDTH=640
PPE_CAMERA_STATUS_HISTORY_DAYS=35
PPE_CAMERA_RECONNECT_INITIAL_SECONDS=2
PPE_CAMERA_RECONNECT_MAX_SECONDS=60
PPE_CAMERA_WATCHDOG_INTERVAL_SECONDS=2
PPE_DEVICE=cpu
PPE_CONF_THRESHOLD=0.45
PPE_CLASS_CONFIDENCE={"person":0.45,"helmet":0.4,"vest":0.4}
PPE_CLASS_BOX_FILTERS={"person":{"min_area_fraction":0.0002,"min_aspect_ratio":0.08,"max_aspect_ratio":2.5}}
PPE_CAMERA_ROIS={"CAM01":[[0.05,0.05],[0.95,0.05],[0.95,0.95],[0.05,0.95]]}
PPE_ASSOCIATION_REGIONS={"helmet":[0.0,0.4],"vest":[0.15,0.85]}
PPE_COMPLIANCE_MODE=explicit_negative
PPE_VIOLATION_CONFIRM_FRAMES=5
PPE_TEMPORAL_CONFIRMATION={"helmet":{"required":5,"window":8},"vest":{"required":5,"window":8}}
PPE_VIOLATION_COOLDOWN_SECONDS=300
PPE_TRACK_HIGH_THRESHOLD=0.5
PPE_TRACK_LOW_THRESHOLD=0.1
PPE_TRACK_NEW_THRESHOLD=0.6
PPE_TRACK_BUFFER=30
PPE_TRACK_MATCH_THRESHOLD=0.8
PPE_API_HOST=127.0.0.1
PPE_API_PORT=8080
PPE_ALERT_OUTBOX_POLL_SECONDS=1
PPE_ALERT_OUTBOX_MAX_ATTEMPTS=5
# Power Automate HTTP trigger URL (contains a secret signature; do not share it).
PPE_POWER_AUTOMATE_WEBHOOK_URL=
PPE_AUTH_ENABLED=true
PPE_SESSION_SECRET=replace-with-at-least-32-random-bytes
PPE_COOKIE_SECURE=false
PPE_SESSION_HOURS=12
